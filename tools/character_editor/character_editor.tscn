ambient_light_energy = 1.4

[sub_resource type="Shader" id="Shader_inspection_grid"]
code = "shader_type spatial;
render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;

uniform vec4 floor_color : source_color = vec4(0.014, 0.018, 0.024, 1.0);
uniform vec4 minor_grid_color : source_color = vec4(0.65, 0.68, 0.72, 0.22);
uniform vec4 major_grid_color : source_color = vec4(0.92, 0.94, 0.98, 0.42);
uniform float grid_cells = 96.0;
uniform float major_every = 4.0;

float grid_line(vec2 coordinate) {
	vec2 pixel_width = fwidth(coordinate);
	vec2 distance_to_line = abs(fract(coordinate - 0.5) - 0.5) / pixel_width;
	return 1.0 - min(min(distance_to_line.x, distance_to_line.y), 1.0);
}

void fragment() {
	vec2 minor_coordinate = UV * grid_cells;
	float minor_line = grid_line(minor_coordinate);
	float major_line = grid_line(minor_coordinate / major_every);
	vec3 surface_color = mix(floor_color.rgb, minor_grid_color.rgb,
			minor_line * minor_grid_color.a);
	surface_color = mix(surface_color, major_grid_color.rgb,
			major_line * major_grid_color.a);
	ALBEDO = surface_color;
	ROUGHNESS = 0.94;
}
"

